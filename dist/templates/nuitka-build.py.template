"""
nuitka-build.py -- [PROJECT_NAME] Nuitka compile pipeline.
Generated from nuitka-build.py.template.

BEFORE FIRST USE: replace these placeholders
    [PROJECT_NAME]   cosmetic name used in the build banner
    [ENTRY_SCRIPT]   path to your main .py file, relative to project root
    [OUTPUT_NAME]    desired .exe filename (e.g. my-tool.exe)

Usage:
    python scripts/build.py              # build (default flags)
    python scripts/build.py --onefile    # single .exe instead of standalone folder
    python scripts/build.py --clean      # delete dist/ and exit

Or double-click build.bat which calls this script automatically.

Why Python instead of PowerShell?
    subprocess.run() does not capture stderr, so Nuitka's progress output
    flows straight to the console without triggering PowerShell's
    $ErrorActionPreference = "Stop" / NativeCommandError problem.
    See NUITKA_GOTCHAS.md #12 for the full explanation.

Prerequisites (run once):
    pip install nuitka ordered-set zstandard
    # plus any runtime deps your project uses (pillow, pystray, etc.)

See NUITKA_GOTCHAS.md (same templates folder) for known pitfalls.
"""

from __future__ import annotations

import shutil
import subprocess
import sys
from pathlib import Path


# ---------------------------------------------------------------------------
# Project root detection
# ---------------------------------------------------------------------------
# Walk upward from this script until a known sentinel file is found.
# Edit SENTINEL to any file that only exists at your project root
# (e.g. "pyproject.toml", "README.md", "src/main.py").

SENTINEL = "src/[ENTRY_SCRIPT]"  # adjust if your layout differs


def _find_project_root() -> Path:
    here = Path(__file__).resolve().parent
    for candidate in (here, here.parent, here.parent.parent):
        if (candidate / SENTINEL).exists():
            return candidate
    raise SystemExit(
        f"Project root not found (searched upward from {here}). "
        f"Expected sentinel: {SENTINEL}"
    )


ROOT = _find_project_root()
DIST = ROOT / "dist"


# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------

def build(onefile: bool = False) -> None:
    entry = ROOT / "[ENTRY_SCRIPT]"
    if not entry.is_file():
        raise SystemExit(f"Entry script not found: {entry}")

    cmd: list[str] = [
        sys.executable, "-m", "nuitka",

        # ---- Mode -----------------------------------------------------------
        "--onefile" if onefile else "--standalone",

        # ---- Console --------------------------------------------------------
        # Use "disable" for GUI apps (no console window).
        # Use "force" for CLI tools that need a visible terminal.
        "--windows-console-mode=disable",

        # ---- GUI plugins (remove if not a tkinter app) ----------------------
        "--enable-plugin=tk-inter",     # bundles TCL/TK DLLs -- required for tkinter
        "--include-package=PIL",        # Pillow uses dynamic imports
        "--include-package=pystray",    # pystray._win32 backend missed by --include-module

        # ---- Anaconda bloat exclusions (safe to remove if not using Anaconda)
        # Building from an Anaconda/conda env causes Nuitka to trace into numpy,
        # scipy, pandas, etc. even when your app never imports them, bundling
        # ~450 MB of Intel MKL DLLs. These flags block that.
        # Remove any package your app actually uses.
        "--nofollow-import-to=numpy",
        "--nofollow-import-to=scipy",
        "--nofollow-import-to=pandas",
        "--nofollow-import-to=matplotlib",
        "--nofollow-import-to=sklearn",
        "--nofollow-import-to=IPython",
        "--nofollow-import-to=notebook",

        # ---- Output ---------------------------------------------------------
        f"--output-dir={DIST}",
        f"--output-filename=[OUTPUT_NAME]",
        "--remove-output",          # delete temp .build / .dist dirs after packing
        "--assume-yes-for-downloads",  # auto-accept MinGW download if MSVC absent

        # ---- Icon (optional) ------------------------------------------------
        # Uncomment and drop icon.ico next to this script to set the exe icon.
        # f"--windows-icon-from-ico={ROOT / 'icon.ico'}",

        # ---- Data files (add as needed) -------------------------------------
        # Use --include-data-file or --include-data-dir to bundle files that
        # your app reads at runtime (configs, templates, assets, etc.).
        # Paths on the right are relative to the exe at runtime.
        # Example:
        #   f"--include-data-file={ROOT / 'data' / 'config.json'}=data/config.json",
        #   f"--include-data-dir={ROOT / 'templates'}=templates",

        str(entry),
    ]

    print(f"\n=== [PROJECT_NAME] -- Nuitka build ===\n")
    print("+ " + " ".join(str(a) for a in cmd))
    print()

    DIST.mkdir(parents=True, exist_ok=True)
    proc = subprocess.run(cmd, cwd=str(ROOT))
    if proc.returncode != 0:
        raise SystemExit(f"Nuitka exited with code {proc.returncode}")

    print()
    if onefile:
        exe = DIST / "[OUTPUT_NAME]"
        size_mb = round(exe.stat().st_size / 1_048_576, 1)
        print(f"Build complete -> {exe}  ({size_mb} MB compressed)")
    else:
        folder = DIST / "[OUTPUT_NAME]".replace(".exe", ".dist")
        print(f"Build complete -> {folder}")
        print(f"Launch: {folder / '[OUTPUT_NAME]'}")

    # ---- Stage extra files (edit per project) -------------------------------
    # Copy any files that should sit next to the exe in dist/ but are not
    # bundled inside it (e.g. a user-editable config, a README, a guide).
    # Example:
    #   import shutil
    #   shutil.copy(ROOT / "README.md", DIST / "README.md")


# ---------------------------------------------------------------------------
# Clean
# ---------------------------------------------------------------------------

def clean() -> None:
    if DIST.is_dir():
        print(f"Removing {DIST} ...")
        shutil.rmtree(DIST)
        print("Done.")
    else:
        print("Nothing to clean.")


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

def main() -> None:
    args = sys.argv[1:]
    if "--clean" in args:
        clean()
        return
    build(onefile="--onefile" in args)


if __name__ == "__main__":
    main()
