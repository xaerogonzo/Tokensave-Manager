# ── Machine-specific config (contains absolute paths for this machine) ──
manager-config.json

# ── Claude Code local session settings ──
.claude/

# ── tokensave index (machine-specific binary database) ──
.tokensave/

# ── Manager-owned per-project cache (test results, allowlists, etc.) ──
# Distinct namespace from .tokensave/ to avoid colliding with tokensave's
# own files. Contains: last_test_run.json, test_allowlist.json (v4.13+).
.tokensave-manager/

# ── CodeGraph SQLite index (machine-specific binary database) ──
# Note: .codegraph/config.json and .codegraph/.gitignore ARE tracked —
# they're per-project indexing config meant to be shared across machines.
# Only the binary DB files are excluded.
.codegraph/codegraph.db
.codegraph/codegraph.db-*

# ── Release artifacts (uploaded as GitHub Release assets, not in git) ──
TokenSave-Manager-v*-windows.zip

# ── Python cache ──
__pycache__/
*.pyc
*.pyo

# ── Test / coverage artefacts ──
.coverage
.coverage.*
coverage.xml
.pytest_cache/

# ── Nuitka build output ──

# ── Logs ──
logs/

# ── Virtual environments ──
.venv/
venv/

# ── OS noise ──
Thumbs.db
.DS_Store

# ── Per-edit backups (manager helpers + tool safety nets) ──
# Pattern matches files like:
#   src/tokensave-manager.py.backup.1779511978257
#   claude_desktop_config.json.backup.1779521543172
# Git history is the canonical safety net; these on-disk snapshots are
# meant to be local-only and should never enter a commit.
*.backup.*

# ── Manager-generated temp files ──
# .pr_context.tmp.md: pre-fetched grounding for Draft PR (CLI deletes
#   it after writing PR_DRAFT.md; gitignored as defence in depth in
#   case the CLI session crashes before cleanup).
# PR_DRAFT.md: the PR description deliverable — content uploaded to
#   GitHub via `gh pr create --body-file PR_DRAFT.md`; the local file
#   itself is transient.
.pr_context.tmp.md
PR_DRAFT.md

# Added by TokenSave Manager
*.local.json

# Added by TokenSave Manager
# AI suggested patterns
*.env
node_modules/
npm-debug.log
yarn-error.log
package-lock.json
# ...except the VS Code extension's, which CI needs: `npm ci` refuses to
# run without a lockfile, and an unpinned `npm install` can resolve
# different typescript/@types versions on different machines. Negated for
# this one path rather than changing the project-wide convention.
!vscode-extension/package-lock.json
.pycache__/

# Added by TokenSave Manager -- and half wrong for this repository.
# The scaffolder ignores build.bat/build.ps1 because in the projects it
# scaffolds they are generated boilerplate from templates/. Here build.ps1
# is bespoke: 283 lines assembling three exes plus templates\, docs\ and
# dist\. Untracked, its fixes lived on one machine -- including the
# -Recurse that is the only reason templates/gotchas/ reaches end users.
# build.bat stays ignored: it really is the 3-line launcher, byte-identical
# to the template and regenerable.
build.bat

# Added by TokenSave Manager
dist/

# tokensave MCP binding (TokenSave Manager) — machine-local by choice
.mcp.json
