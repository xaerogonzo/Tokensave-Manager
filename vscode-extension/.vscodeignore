.vscode/**
node_modules/**
src/**
test/**
tsconfig.json
.gitignore
package-lock.json

# The whole bin/ tree, not just the README that used to be named here.
#
# `bin/**/README.md` excluded exactly one file, so a locally built
# `bin/windows-x64/tokensave-manager-cli.exe` — gitignored, but present after
# any run of the Manager's build.ps1 — would be packaged. That turns a ~14 KB
# extension into a ~15 MB one silently, and ships a snapshot CLI that goes
# stale the moment the Manager changes.
#
# Bundling a CLI is still supported, but it is now a deliberate act: remove
# this line before packaging. The release workflow asserts the binary is
# ABSENT, so the accident cannot ship even if this file is edited by mistake.
bin/**

# Test-run scratch: profiles, downloaded editors, the disposable fixture. These
# did not exist before the live suite, and nothing excluded them — the packaged
# extension went from 43 KB to 5.3 MB with 392 files, most of it a VS Code user
# profile. Caught by the size assertion in test/integration/runTestsVsix.js
# rather than at publish time, which is the whole reason that assertion exists.
.vscode-test/**
.vscode-test-vsix/**
.vscode-test-desktop/**

**/*.map
**/*.ts
!out/**/*.js
